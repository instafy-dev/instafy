{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instafy.dev/schemas/ota/device-update-check.schema.json",
  "title": "Instafy OTA Device Update Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "platform",
    "channel",
    "native_version"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["ios", "android"]
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "native_version": {
      "type": "string",
      "minLength": 1
    },
    "native_build": {
      "type": ["string", "null"],
      "maxLength": 64,
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$(?![\\s\\S])"
    },
    "current_bundle_version": {
      "type": ["string", "null"]
    },
    "current_git_sha": {
      "type": ["string", "null"]
    }
  }
}
