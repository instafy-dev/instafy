{
  "name": "@instafy/desktop-runtime-agent",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Desktop runtime launcher for Instafy Studio (developer preview).",
  "type": "module",
  "private": true,
  "bin": {
    "instafy-desktop": "./bin/instafy-desktop.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/cli.ts",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsup": "^7.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2"
  }
}
