{
  "name": "@instafy/desktop-runtime-agent",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Desktop runtime launcher for Instafy Studio (developer preview).",
  "type": "module",
  "private": true,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  }
}
