{
  "name": "@instafy/desktop-app",
  "private": true,
  "version": "0.2.20",
  "license": "AGPL-3.0-only",
  "description": "Instafy desktop app (Electron).",
  "desktopName": "dev.instafy.studio.desktop",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @instafy/desktop-runtime-agent build && tsup && node scripts/sync-frontend-host-scripts.mjs && node scripts/download-speech-bootstrap-assets.mjs",
    "start": "pnpm --filter @instafy/desktop-runtime-agent build && pnpm build && node scripts/launch.mjs",
    "smoke:browser:video": "pnpm build && electron scripts/browser-tab-video-smoke.cjs",
    "smoke:browser:explore": "pnpm build && electron scripts/browser-tab-explore-smoke.cjs",
    "smoke:studio:permissions": "pnpm build && electron scripts/studio-permissions-smoke.cjs",
    "smoke:studio:window-open": "pnpm build && electron scripts/window-open-smoke.cjs",
    "smoke:voice:host": "pnpm build && node scripts/voice-host-smoke.mjs",
    "smoke:voice:host:bootstrap": "pnpm build && node scripts/voice-host-smoke.mjs --bootstrap-clean",
    "test": "pnpm build && install-electron && node --test test/*.test.mjs",
    "stage:runtime-agent": "node scripts/stage-runtime-agent.mjs",
    "dist": "pnpm build && pnpm stage:runtime-agent && electron-builder --publish never",
    "verify:packaged-runtime-agent": "node scripts/verify-packaged-runtime-agent.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@instafy/browser-action-policy": "workspace:*",
    "@instafy/desktop-runtime-agent": "workspace:*",
    "@instafy/provider-client": "workspace:*",
    "@instafy/provider-contract": "workspace:*",
    "@instafy/sdk": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@instafy/bind": "workspace:*",
    "@types/node": "^22.18.0",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "jsdom": "26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "undici": "6.29.1"
  },
  "build": {
    "appId": "dev.instafy.studio",
    "productName": "Instafy",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://downloads.instafy.dev/desktop-app/stable"
    },
    "artifactName": "instafy-${version}-${os}.${ext}",
    "afterPack": "scripts/finalize-runtime-agent-manifest.cjs",
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "dist/**",
      "assets/browser-tab-video.html",
      "package.json",
      "!**/node_modules/**/*.test.ts",
      "!**/node_modules/**/tests/**"
    ],
    "extraResources": [
      {
        "from": "build/runtime-agent",
        "to": "runtime-agent",
        "filter": [
          "runtime-agent*",
          "codex-code-mode-host*",
          "skill-packs/**"
        ]
      }
    ],
    "asarUnpack": [
      "dist/native/**"
    ],
    "protocols": [
      {
        "name": "Instafy",
        "schemes": [
          "instafy"
        ]
      }
    ],
    "mac": {
      "artifactName": "instafy-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "binaries": [
        "Contents/Resources/runtime-agent/runtime-agent",
        "Contents/Resources/runtime-agent/codex-code-mode-host"
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Instafy uses Bluetooth to connect to hardware selected by you.",
        "NSBluetoothPeripheralUsageDescription": "Instafy uses Bluetooth to connect to hardware selected by you.",
        "NSLocationUsageDescription": "Instafy uses your location when a site you open asks for it. You'll see a location marker when one does.",
        "NSLocationWhenInUseUsageDescription": "Instafy uses your location when a site you open asks for it. You'll see a location marker when one does."
      },
      "entitlements": "assets/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "instafy-studio",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExts": [
        "runtime-agent.exe",
        "codex-code-mode-host.exe"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
