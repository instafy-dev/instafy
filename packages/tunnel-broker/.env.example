# Broker service configuration
DATABASE_URL=postgres://tunnel_broker:password@localhost:5545/tunnel_broker
HTTP_BIND=0.0.0.0:8082
TUNNEL_DOMAIN=rt.test
INGRESS_HOST=ingress.rt.test
INGRESS_PORT=37000
PUBLIC_INGRESS_PORT=8083
INGRESS_IPV4=127.0.0.1
DEFAULT_TTL_SECONDS=60
RATHOLE_SHARED_TOKEN=dev-tunnel-token
RATHOLE_PORT_RANGE_START=20000
RATHOLE_PORT_RANGE_END=40000
RATHOLE_CONFIG_OUTPUT=
RATHOLE_CONFIG_REFRESH_SECONDS=10
RATHOLE_CONFIG_NOTIFY_CHANNEL=tunnel_config_refresh
RATHOLE_RELOAD_COMMAND=
RATHOLE_PID_FILE=
TOKEN_SIGNING_KEY=dev-secret-change-me
BROKER_API_TOKENS=dev-token
TOKEN_ISSUER=instafy-tunnel-broker
TOKEN_AUDIENCE=
TUNNEL_TOKEN_TTL_SECONDS=900
ACL_HOOK_URL=
ACL_HOOK_TOKEN=
EVENT_HOOK_URL=
EVENT_HOOK_TOKEN=
TRAEFIK_CERT_RESOLVER=
# Private previews (off unless all three are set). Locally, for example:
# PREVIEW_DOMAIN=preview.localhost
# PREVIEW_AUTH_ADDRESS=http://broker:8080
# PREVIEW_AUTH_HOOK_URL=http://host.docker.internal:8788/tunnel-broker/hooks/preview-auth
# PREVIEW_DOMAIN may equal TUNNEL_DOMAIN (one user-content domain for tunnels and previews),
# but not sit above or below it. See docs/integration.md.
PREVIEW_DOMAIN=
PREVIEW_AUTH_ADDRESS=
PREVIEW_AUTH_HOOK_URL=
PREVIEW_MAX_TTL_SECONDS=43200
RATHOLE_UPSTREAM_HOST=rathole
