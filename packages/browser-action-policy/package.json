      "types": "./actionPolicy.d.ts",
      "default": "./actionPolicy.js"
    },
    "./pageCapture": {
      "types": "./pageCapture.d.ts",
      "default": "./pageCapture.js"
    },
    "./formSubmission": {
      "types": "./formSubmission.d.ts",
      "default": "./formSubmission.js"
    },
    "./linkOnly": {
      "types": "./linkOnly.d.ts",
      "default": "./linkOnly.js"
    }
  },
  "files": [
    "redaction.js",
    "redaction.d.ts",
    "actionPolicy.js",
    "actionPolicy.d.ts",
    "pageCapture.js",
    "pageCapture.d.ts",
    "formSubmission.js",
    "formSubmission.d.ts",
    "linkOnly.js",
    "linkOnly.d.ts",
    "README.md"
  ]
