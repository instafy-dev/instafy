{
  "name": "@instafy/frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./feature-api": "./src/feature-api/index.ts",
    "./feature-api/controller": "./src/feature-api/controller.ts",
    "./feature-api/runtime": "./src/feature-api/runtime.ts",
    "./feature-api/runtime-bridge": "./src/feature-api/runtimeBridge.ts",
    "./feature-api/ui": "./src/feature-api/ui.ts",
    "./feature-api/voice": "./src/feature-api/voice.ts"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:local-provider-host": "node ./scripts/local-provider-host.mjs",
    "dev:speech-service": "node ./scripts/local-speech-service.mjs",
    "dev:speech-host:server": "node ./scripts/server-speech-host.mjs",
    "speech:bootstrap:check": "node ./scripts/speech-bootstrap-cli.mjs check",
    "speech:bootstrap:install": "node ./scripts/speech-bootstrap-cli.mjs install-transcription",
    "speech:fixtures:check": "node ./scripts/speech-fixture-check.mjs",
    "dev:robot-bridge": "node ./scripts/local-provider-host.mjs",
    "dev:prod": "node ./scripts/dev-prod.mjs",
    "build": "node ../../scripts/run-vite-package-build.mjs",
    "preview": "vite preview",
    "preview:prod": "node ./scripts/preview-prod.mjs",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:add:android": "pnpm exec cap add android",
    "cap:sync": "node ../../scripts/set-capacitor-frontend-env.mjs && pnpm build && pnpm exec cap sync",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:open:android": "pnpm exec cap open android",
    "check:ios:config": "node ../../scripts/check-ios-config.mjs",
    "check:android:config": "node ../../scripts/check-android-config.mjs",
    "test:ios:build": "pnpm check:ios:config && pnpm cap:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "test:ios:simulator:camera:smoke": "CAPACITOR_FRONTEND_ENV=local node ../../scripts/ios-simulator-debug.mjs capture -- --test AppUITests/AppUITests/testCaptureCameraExtensionFlow",
    "test:android:build": "node ../../scripts/test-android-build.mjs",
    "test:android:camera:smoke": "node ./scripts/android-camera-extensions-smoke.mjs",
    "test:camera:tri-client:smoke": "node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:desktop-provider": "TRI_CLIENT_CAMERA_FLOW=desktop-provider TRI_CLIENT_PHONE_PLATFORM=ios node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:desktop-provider:ios-simulator": "CAPACITOR_FRONTEND_ENV=local TRI_CLIENT_CAMERA_FLOW=desktop-provider TRI_CLIENT_PHONE_PLATFORM=ios-simulator node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:recommended": "TRI_CLIENT_MULTI_DEVICE=1 TRI_CLIENT_MULTI_DEVICE_IOS_PLATFORM=ios-simulator node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:two-devices": "TRI_CLIENT_MULTI_DEVICE=1 node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:two-devices:ios-simulator": "TRI_CLIENT_MULTI_DEVICE=1 TRI_CLIENT_MULTI_DEVICE_IOS_PLATFORM=ios-simulator node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:camera:tri-client:smoke:ios-simulator": "CAPACITOR_FRONTEND_ENV=local TRI_CLIENT_PHONE_PLATFORM=ios-simulator node ./scripts/tri-client-local-camera-smoke.mjs",
    "test:automation:cleanup": "node ./scripts/automation-cleanup.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run",
    "test:e2e": "node ./scripts/playwright-test.mjs",
    "test:e2e:component": "node ./scripts/playwright-test.mjs --project=component --max-failures=1",
    "test:e2e:bench": "PLAYWRIGHT_RUN_BENCH=1 node ./scripts/playwright-test.mjs tests/playwright/bench --max-failures=1",
    "test:e2e:conversation-perf": "playwright test --config playwright.conversation-perf.config.ts",
    "test:e2e:smoke": "node ./scripts/playwright-test.mjs tests/playwright/smoke --max-failures=1",
    "test:e2e:smoke:core": "node ./scripts/playwright-test.mjs tests/playwright/api tests/playwright/smoke/conversation-smoke.spec.ts tests/playwright/smoke/file-explorer-ui.spec.ts tests/playwright/smoke/project-picker.spec.ts tests/playwright/smoke/runtime-ai-model-select.spec.ts --max-failures=1",
    "test:e2e:chat:voice:speech": "node ./scripts/playwright-test.mjs tests/playwright/smoke/chat-voice-speech.spec.ts --project=chromium --no-deps --max-failures=1",
    "test:e2e:desktop:camera": "PLAYWRIGHT_ELECTRON_DESKTOP_CAMERA=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/chat-octo-electron-desktop-camera-provider.spec.ts --project=chromium --max-failures=1",
    "test:e2e:desktop:personal-browser": "PLAYWRIGHT_ELECTRON_PERSONAL_BROWSER=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/electron-personal-browser.spec.ts --project=chromium --no-deps --max-failures=1",
    "test:e2e:desktop:auth-callback": "PLAYWRIGHT_ELECTRON_AUTH_CALLBACK=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/electron-auth-callback.spec.ts --project=chromium --no-deps --max-failures=1",
    "test:e2e:desktop:personal-browser-agent-turn": "PLAYWRIGHT_ELECTRON_PERSONAL_BROWSER_AGENT_TURN=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/electron-personal-browser-agent-turn.prod.spec.ts --project=chromium --no-deps --workers=1 --retries=0 --max-failures=1 --trace=off",
    "test:e2e:browser:responsive": "PLAYWRIGHT_SHARED_BROWSER_RESPONSIVE=1 INSTAFY_ENABLE_BROWSER_SESSION=1 PLAYWRIGHT_FORCE_FRESH_SERVER=1 VITE_INSTAFY_SHARED_BROWSER_CDP_SCREENCAST=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/browser-session-responsive.spec.ts --project=chromium --max-failures=1",
    "test:e2e:desktop:browser-experience": "pnpm --filter @instafy/desktop-app build && PLAYWRIGHT_ELECTRON_BROWSER_EXPERIENCE=1 PLAYWRIGHT_FORCE_FRESH_SERVER=1 VITE_INSTAFY_SHARED_BROWSER_CDP_SCREENCAST=1 VITE_INSTAFY_SHARED_BROWSER_WEBRTC=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/electron-browser-experience.spec.ts --project=chromium --no-deps --max-failures=1",
    "test:e2e:desktop:shared-browser-collaboration": "pnpm --filter @instafy/desktop-app build && PLAYWRIGHT_SHARED_BROWSER_WEB_ELECTRON_COLLABORATION=1 PLAYWRIGHT_FORCE_FRESH_SERVER=1 VITE_INSTAFY_SHARED_BROWSER_CDP_SCREENCAST=1 node ./scripts/playwright-test.mjs tests/playwright/orgs/org-shared-browser-web-electron-collaboration.spec.ts --project=chromium-orgs --max-failures=1",
    "test:e2e:desktop:shared-browser-agent-turn": "pnpm --filter @instafy/desktop-app build && PLAYWRIGHT_ELECTRON_SHARED_BROWSER_AGENT_TURN=1 node ./scripts/playwright-test.mjs tests/playwright/smoke/electron-shared-browser-agent-turn.prod.spec.ts --project=chromium --no-deps --max-failures=1",
    "test:e2e:controller": "node ./scripts/playwright-test.mjs tests/playwright/api --max-failures=1",
    "test:e2e:projects": "node ./scripts/playwright-test.mjs tests/playwright/projects --max-failures=1",
    "test:e2e:orgs": "node ./scripts/playwright-test.mjs tests/playwright/orgs --max-failures=1",
    "test:e2e:payments": "node ./scripts/playwright-test.mjs tests/playwright/credits tests/playwright/payments --max-failures=1",
    "test:e2e:automations": "node ./scripts/playwright-test.mjs tests/playwright/automations --max-failures=1",
    "test:e2e:voice": "node ./scripts/playwright-test.mjs tests/playwright/smoke/chat-voice-speech.spec.ts --max-failures=1",
    "test:e2e:headed": "node ./scripts/playwright-test.mjs --max-failures=1 --headed",
    "set:local-frontend-env": "node ../../scripts/set-local-frontend-env.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-live-update": "^8.2.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@instafy/ota-contracts": "workspace:*",
    "@instafy/provider-client": "workspace:*",
    "@instafy/provider-contract": "workspace:*",
    "@instafy/sdk": "workspace:*",
    "@lexical/react": "^0.39.0",
    "@lexical/text": "^0.39.0",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.5.0",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.90.20",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "iconoir-react": "^7.11.0",
    "lexical": "^0.39.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.9.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@instafy/desktop-runtime-agent": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/wicg-file-system-access": "^2023.10.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.4.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
