# Instafy Studio local overrides
# Copy this file to `.env.local` and fill in your private credentials.

# Cloudflare (Pages + DNS)
# Used by `.github/workflows/deploy.yml` and helper scripts under `scripts/`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Self-hosted tunneling (tunnel broker)
TUNNEL_BROKER_BASE_URL=
TUNNEL_BROKER_TOKEN=
# Optional: TUNNEL_BROKER_HOOK_SECRET=
