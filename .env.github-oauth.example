# GitHub OAuth App (device-code flow) for controller-side GitHub import.
#
# This is NOT the same as the Supabase "Continue with GitHub" login.
# The controller uses GitHub's device flow to obtain a GitHub access token so it can
# import/clone private repositories on behalf of a user.
#
# How to create:
# - GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# - Enable "Device Flow"
# - Copy the "Client ID" here
#
# Note: GitHub "Client Secret" is NOT required for the device-code flow we implement today.
# Keep any secret in a password manager (do not commit it).

# Required (controller env):
GITHUB_DEVICE_AUTH_CLIENT_ID=

# Optional (defaults to "repo"):
# GITHUB_DEVICE_AUTH_SCOPE=repo

