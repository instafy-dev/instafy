# Supabase (hosted) configuration.
# Copy to `$INSTAFY_ENV_DIR/.env.supabase` (mode 0600) and fill in values.

# Frontend (Vite)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
# IMPORTANT: copy the project's "anon" key from Supabase Dashboard → Project Settings → API → Project API keys.
# Do not generate a JWT from SUPABASE_JWT_SECRET; Supabase validates API keys by exact match.
VITE_SUPABASE_ANON_KEY=

# Server/admin processes only. Never add a VITE_ alias for either secret below:
# Vite-prefixed values are delivered to browser code.
SUPABASE_PROJECT_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Some tooling/doc paths still refer to this name.
SERVICE_ROLE_KEY=

# PWA Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@instafy.dev

# Native iOS push (APNs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dev.instafy.studio
# Prefer the base64 form for multiline keys.
APNS_PRIVATE_KEY_B64=
# Optional: set to 1/true for sandbox testing.
APNS_USE_SANDBOX=
