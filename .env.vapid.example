# Web Push (VAPID) configuration.
# Copy to `.env.vapid` (gitignored) and fill in values (or run the helper to generate them).

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional contact for VAPID JWT "sub" claim (recommended).
WEB_PUSH_VAPID_SUBJECT=mailto:contact+notifications@instafy.dev
