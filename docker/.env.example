# ---- Runtime compose defaults ----
# Copy this file to `$INSTAFY_ENV_DIR/docker/.env.local` (mode 0600) and adjust values.

# Supabase Edge endpoint (local default points at `pnpm supabase:up`)
EDGE_URL=http://host.docker.internal:54321/functions/v1
AGENT_REGISTER_URL=/runtime/register
AGENT_LOGIN_URL=/agent/login
AGENT_LOGIN_KEY=dev-agent-key

# Runtime auth
AGENT_TOKEN=
AGENT_KEY=dev-agent-key
SPACE_ID=00000000-0000-0000-0000-000000000000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RUNTIME_TYPE=codex-embedded
RUNTIME_REPO_HOST=../..
RUNTIME_CODEX_VOLUME=../tmp/runtime-sandbox/.codex
# Shared Browser outbound traffic is fail-closed through this loopback proxy.
INSTAFY_BROWSER_EGRESS_ISOLATION=1
# Development tests only. Setting both isolation=0 and this flag=1 permits an
# unsafe direct-network Chromium launch.
INSTAFY_BROWSER_EGRESS_ALLOW_UNSAFE_DEV=0
INSTAFY_BROWSER_EGRESS_PROXY_BIND=127.0.0.1:9226
INSTAFY_BROWSER_EGRESS_ALLOWED_PORTS=80,443
INSTAFY_BROWSER_EGRESS_MAX_CONNECTIONS=128
INSTAFY_BROWSER_CDP_SCREENCAST=0
INSTAFY_BROWSER_WEBRTC_ENABLED=0
INSTAFY_BROWSER_PREFERRED_VIEWER=
INSTAFY_BROWSER_WEBRTC_REQUIRE_TURN=0
# Provider-owned in hosted deployments; static credentials are development-only.
INSTAFY_BROWSER_WEBRTC_ICE_SERVERS_JSON=
INSTAFY_BROWSER_WEBRTC_FPS=30
INSTAFY_BROWSER_WEBRTC_BITRATE_KBPS=3500
CODEX_HOME=/workspace/.codex
CODEX_AUTH_PATH=/workspace/.codex/auth.json
CODEX_API_ENDPOINT=http://host.docker.internal:8789/api
CODEX_PROXY_CHATGPT_ENDPOINT=http://host.docker.internal:8789/backend-api/codex/responses
OPENAI_BASE_URL=http://host.docker.internal:8789/v1
CODEX_API_KEY=proxy-dev-key
CODEX_MODEL=gpt-5.5
CODEX_MODEL_PROVIDER=
CODEX_PROFILE=
CODEX_SANDBOX_MODE=danger-full-access
CODEX_BASE_INSTRUCTIONS=
CODEX_INCLUDE_PLAN_TOOL=true
CODEX_INCLUDE_APPLY_PATCH_TOOL=true
CODEX_INCLUDE_VIEW_IMAGE_TOOL=true
CODEX_SHOW_RAW_AGENT_REASONING=
CODEX_ENABLE_WEB_SEARCH=
CODEX_DISABLED=0
CONTROLLER_BASE_URL=http://host.docker.internal:8788
CONTROLLER_INTERNAL_TOKEN=dev-internal-token
# Separate authority used only between the controller and OpenAI proxy.
PROXY_CREDENTIAL_LEASE_TOKEN=dev-proxy-credential-lease-token
PROXY_BASE_URL=http://host.docker.internal:8789
PROXY_SIGNING_SECRET=dev-proxy-secret
PROXY_TOKEN_TTL_SECONDS=1800
USE_PROXY_FOR_LLM=1

# Shared workspace
WORKSPACE_DIR=/workspace

# Origin (workspace gateway)
# Required: runtime-agent always launches an Origin instance.
ORIGIN_ID=00000000-0000-0000-0000-000000000000
ORIGIN_BIND_HOST=0.0.0.0
ORIGIN_BIND_PORT=54332
ORIGIN_HOST_PORT=54332
ORIGIN_ENDPOINT=http://host.docker.internal:54332
ORIGIN_SKIP_AUTH=0
ORIGIN_ENABLE_PRESENCE_HEARTBEAT=1
ORIGIN_INTERNAL_TOKEN=dev-internal-token
ORIGIN_PROTOCOLS=http
ORIGIN_MODE=desktop
ORIGIN_DEVICE_ID=runtime-desktop

# Git-canonical (optional)
# When set, Origin will `clone/fetch` from the git service and `commit+push` on POST /apply.
ORIGIN_GIT_REMOTE_URL=
ORIGIN_GIT_BRANCH=main
ORIGIN_GIT_REMOTE_NAME=origin
ORIGIN_GIT_AUTHOR_NAME=instafy-origin
ORIGIN_GIT_AUTHOR_EMAIL=origin@instafy.dev

# Hosted Origin gateway (multi-tenant, git-canonical)
# This is a standalone Origin process that can serve many projects (durable source of truth is git).
ORIGIN_GATEWAY_ID=00000000-0000-0000-0000-000000000000
ORIGIN_GATEWAY_PORT=54333
ORIGIN_GATEWAY_SKIP_AUTH=0
ORIGIN_GATEWAY_PROJECT_ID=00000000-0000-0000-0000-000000000000
ORIGIN_GATEWAY_WORKSPACE_VOLUME=../tmp/origin-gateway-workspaces
ORIGIN_GIT_REMOTE_BASE_URL=http://git-edge:8080

# Git Service (git-canonical)
GIT_EDGE_SKIP_AUTH=0
GIT_EVENTS_WEBHOOK_URL=http://host.docker.internal:8788/git/hooks/events
GIT_EVENTS_WEBHOOK_TOKEN=dev-internal-token
GIT_EVENTS_WEBHOOK_TIMEOUT_MS=3000
# Controller-side verifier for /git/hooks/events (defaults to CONTROLLER_INTERNAL_TOKEN when unset).
# GIT_EVENT_HOOK_SECRET=dev-internal-token
# Git shard policy (repo hygiene)
GIT_MAX_BLOB_BYTES=20971520
# Optional extra deny patterns (comma-separated globs):
# GIT_DENY_PATHS=*/vendor/*,*.zip
# Disable git-shard policy (unsafe; local-only):
# GIT_POLICY_DISABLED=1

# Optional premium UI (openvscode-server)
# CODE_SERVER_PASSWORD=dev-password
# CLINE_EXTENSION_ID=saoudrizwan.cline
# USE_PROXY_FOR_LLM=1

# Optional Edge overrides (usually leave default)
EDGE_DISPATCH_WORKFLOW_PATH=/dispatch_workflow
EDGE_DISPATCH_BUILD_PATH=/dispatch_build
EDGE_PROGRESS_CALLBACK_PATH=/progress_callback
EDGE_SUPABASE_RPC_PREFIX=/rpc
EDGE_CREATE_PULL_REQUEST_PATH=/github/create_pull_request
EDGE_SUPABASE_SQL_PATH=/sql
