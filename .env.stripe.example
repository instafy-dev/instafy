# Secret API key for Stripe, used to create Checkout Sessions. Keep the
# committed template blank and set a real test key only in
# `$INSTAFY_ENV_DIR/.env.stripe` (mode 0600).
STRIPE_SECRET_KEY=

# Note: the current flow uses hosted Stripe Checkout + server-side redirects, so a Stripe publishable key
# is not required unless you later embed Stripe.js elements in the frontend.

# Optional Stripe API base URL; defaults to https://api.stripe.com if unset.
STRIPE_API_BASE_URL=https://api.stripe.com

# Stripe price ID mapped to the Starter plan (optional if Starter is free).
STRIPE_PRICE_ID_STARTER=price_starter123

# Stripe price ID mapped to the Pro plan (required for paid subscriptions).
STRIPE_PRICE_ID_PRO=price_pro123

# Stripe price ID mapped to the Scale plan (required for paid subscriptions).
STRIPE_PRICE_ID_SCALE=price_scale123

# Stripe webhook secret used to verify checkout.session events.
STRIPE_WEBHOOK_SECRET=whsec_yourWebhookSecret

# Optional (local dev helper): product IDs used by `pnpm stripe:sync-env` to keep price IDs in sync.
STRIPE_PRODUCT_ID_PRO=prod_pro123
STRIPE_PRODUCT_ID_SCALE=prod_scale123
